rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin"
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isActive == true;
    }

    // Lectura pública limitada al catálogo que se implementará posteriormente.
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Un usuario autenticado puede leer solo su propio perfil de rol.
    // La creación y modificación de perfiles quedan reservadas a administradores.
    match /users/{userId} {
      allow get: if signedIn() && request.auth.uid == userId;
      allow get, list, create, update, delete: if isAdmin();
    }

    // Colecciones sensibles: bloqueadas para usuarios no administradores.
    match /customers/{customerId} {
      allow read, write: if isAdmin();
    }

    match /orders/{orderId} {
      allow read, write: if isAdmin();
    }

    match /order_items/{orderItemId} {
      allow read, write: if isAdmin();
    }

    match /payments/{paymentId} {
      allow read, write: if isAdmin();
    }

    match /inventory_movements/{movementId} {
      allow read, write: if isAdmin();
    }

    match /expenses/{expenseId} {
      allow read, write: if isAdmin();
    }

    // Otras colecciones, incluido `settings`, permanecen denegadas por defecto.
  }
}
